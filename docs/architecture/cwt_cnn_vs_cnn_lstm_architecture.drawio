        </mxCell>
        <mxCell id="notes" value="Protocol notes&lt;br&gt;Same CWT representation for both models&lt;br&gt;Same CwtEncoder architecture and initialization&lt;br&gt;CNN uses one frame at time t&lt;br&gt;CNN-LSTM uses causal 16-frame sequence ending at t&lt;br&gt;No future frame x&lt;sub&gt;t+1&lt;/sub&gt; is used&lt;br&gt;Task: FPT detection, not RUL prediction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
