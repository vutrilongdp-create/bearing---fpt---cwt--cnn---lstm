        <mxCell id="encoder_detail" value="CwtEncoder details&lt;br&gt;Conv 3x3: 2-&gt;16 + GroupNorm + ReLU + MaxPool&lt;br&gt;Conv 3x3: 16-&gt;32 + GroupNorm + ReLU + MaxPool&lt;br&gt;Conv 3x3: 32-&gt;64 + GroupNorm + ReLU + MaxPool&lt;br&gt;Conv 3x3: 64-&gt;128 + GroupNorm + ReLU + MaxPool&lt;br&gt;AdaptiveAvgPool2d(1) -&gt; Flatten -&gt; 128-D" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
